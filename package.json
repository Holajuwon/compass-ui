    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "axios": "1.20.0",
    "framer-motion": "14.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "5.7.0",
    "react-router-dom": "6.30.6",
